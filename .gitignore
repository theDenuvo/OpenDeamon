# A:\OpenDeamon\.gitignore
# --- large artifacts / caches ---
cache/
node_modules/
desktop/
owui/
models/
__pycache__/
*.pyc
*.log
*.png
*.jpg
*.jpeg
*.safetensors
*.ckpt
*.mp4
tests/
_setup_tmp/
searxng/data/
gateway/pgdata/

# --- SECRETS: never in git, no exceptions ---
*.env
*.env.*
**/.master_key.env
secrets/
hermes-home/.env
hermes-home/auth.json
hermes-home/auth.lock
hermes-home/.install_id.lock
hermes-home/*.lock
hermes-home/.hermes_history

# --- runtime state: not source ---
hermes-home/state.db*
hermes-home/shared-state.db*
hermes-home/projects.db*
hermes-home/state/
hermes-home/sessions/
hermes-home/logs/
hermes-home/cache/
hermes-home/audio_cache/
hermes-home/image_cache/
hermes-home/attachments/
hermes-home/backups/
hermes-home/runtime/
hermes-home/sandboxes/
hermes-home/bot_relay/
hermes-home/desktop-plugins/
hermes-home/processes.json
hermes-home/spawn-ledger.json
hermes-home/provider_models_cache.json
hermes-home/models_dev_cache.json
hermes-home/models_dev_cache.etag
hermes-home/install_id
hermes-home/desktop-build-stamp.json
hermes-home/.npm_lock_hash_*

.DS_Store

# --- bulk binaries and runtime artifacts that bloated the repo to 101 MB ---
# third-party executables: present on disk, never in history
tools/ffmpeg/
# 47 MB hub catalogue snapshot: regenerable by `hermes skills` from the network
hermes-home/skills/.hub/index-cache/
# sprite sheets are binary assets shipped with the pet pack
hermes-home/pets/*/spritesheet.webp
# cron run log: append-only runtime state
hermes-home/cron/executions.db
hermes-home/cron/*.db
# model weights and large generated artifacts
hermes-home/generated/
A:/generated/
